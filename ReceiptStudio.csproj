<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>ReceiptStudio</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Tesseract" Version="5.2.0" GeneratePathProperty="true" />
    <EmbeddedResource Include="ocr-data\*.traineddata" LogicalName="ocr.%(Filename)%(Extension)" />
    <EmbeddedResource Include="$(PkgTesseract)\x64\*.dll" LogicalName="ocr.%(Filename)%(Extension)" />
    <EmbeddedResource Include="licenses\*" LogicalName="licenses.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
